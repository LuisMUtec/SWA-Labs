   "version": 1,
   "versionNonce": 14233686,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Negro: legacy que sigue igual.  Azul: nuevo con reliability / fault tolerance.\nNaranja: migracion evolutiva (Strangler router, ACL, feature flag, interceptor).\nRojo: SPOF / Bottleneck y flujos alternos.  Verde grueso: critical path.\nLinea solida = sincrono.  Punteada = asincrono (eventos, logs).\nCajas apiladas = << Replicas >>.  Recuadros: HOST / New Architecture / Legacy.",
   "originalText": "Negro: legacy que sigue igual.  Azul: nuevo con reliability / fault tolerance.\nNaranja: migracion evolutiva (Strangler router, ACL, feature flag, interceptor).\nRojo: SPOF / Bottleneck y flujos alternos.  Verde grueso: critical path.\nLinea solida = sincrono.  Punteada = asincrono (eventos, logs).\nCajas apiladas = << Replicas >>.  Recuadros: HOST / New Architecture / Legacy.",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "L12e00135",
   "type": "text",
   "x": 740.0,
   "y": 1400.0,
   "width": 475.2,
   "height": 27.5,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "c02B",
   "roundness": null,
   "seed": 1169065,
   "version": 1,
   "versionNonce": 14338415,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Flujos alternos (que pasa si falla?)",
   "originalText": "Flujos alternos (que pasa si falla?)",
