  {
   "id": "L12e00250",
   "type": "text",
   "x": 2900.0,
   "y": 2883.0,
   "width": 770.5600000000001,
   "height": 80.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
