  {
   "id": "L12e00248",
   "type": "text",
   "x": 2900.0,
   "y": 2763.0,
   "width": 627.2,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
