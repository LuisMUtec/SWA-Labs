  },
  {
   "id": "L12e00136",
   "type": "text",
   "x": 740.0,
   "y": 1435.5,
   "width": 604.8,
   "height": 87.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
