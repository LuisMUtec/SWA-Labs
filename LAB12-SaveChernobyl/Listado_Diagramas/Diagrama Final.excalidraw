   "index": "c02C",
   "roundness": null,
   "seed": 1176984,
   "version": 1,
   "versionNonce": 14443144,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "OFF 1: sensor sin respuesta (timeout) -> Unhealthy;\n  el Controller sigue con los demas medidores + WARN + alarma.\nOFF 2: Main Controller sin respuesta -> Circuit Breaker abierto\n  -> decision local en el HOST + alarma (modo local).\nOFF 3: refrigeracion sin ack -> Retry N=2 -> alarma critica al operador.",
   "originalText": "OFF 1: sensor sin respuesta (timeout) -> Unhealthy;\n  el Controller sigue con los demas medidores + WARN + alarma.\nOFF 2: Main Controller sin respuesta -> Circuit Breaker abierto\n  -> decision local en el HOST + alarma (modo local).\nOFF 3: refrigeracion sin ack -> Retry N=2 -> alarma critica al operador.",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "L12e00137",
