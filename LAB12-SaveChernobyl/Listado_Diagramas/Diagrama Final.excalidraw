   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Branch by Abstraction + feature flag solo en reactor 1 (parallel run).\nMedir baseline vs nueva: p50 / p95 / p99, availability, reliability.\nDecision: GO | GO WITH CHANGES | NO-GO. Si falla: flag off (rollback).",
   "originalText": "Branch by Abstraction + feature flag solo en reactor 1 (parallel run).\nMedir baseline vs nueva: p50 / p95 / p99, availability, reliability.\nDecision: GO | GO WITH CHANGES | NO-GO. Si falla: flag off (rollback).",
   "fontSize": 16,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
