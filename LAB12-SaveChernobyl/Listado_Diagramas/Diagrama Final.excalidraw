  {
   "id": "L12e00125",
   "type": "text",
   "x": 0.0,
   "y": 1971.0,
   "width": 885.9200000000001,
   "height": 17.5,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
