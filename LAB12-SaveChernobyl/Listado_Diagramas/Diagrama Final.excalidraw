   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Fase 0: foto actual (dependencias, flujo de datos, puntos de integracion).\nFase 1: Sidecar proxy + Event Interceptor para sacar logs del legacy sin tocarlo.\nFase 2: Strangler: reactor 1 al controller nuevo; Main nuevo en parallel run (shadow).\nFase 3: reactores 2 y 3; data: migracion paralela (CDC). Legacy -> R.I.P.",
   "originalText": "Fase 0: foto actual (dependencias, flujo de datos, puntos de integracion).\nFase 1: Sidecar proxy + Event Interceptor para sacar logs del legacy sin tocarlo.\nFase 2: Strangler: reactor 1 al controller nuevo; Main nuevo en parallel run (shadow).\nFase 3: reactores 2 y 3; data: migracion paralela (CDC). Legacy -> R.I.P.",
   "fontSize": 16,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  }
